{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "dist/**",
        ".mastra/output/**",
        "runtime/server/**"
      ]
    },
    "stage-server": {
      "dependsOn": ["mastra-app#build"],
      "outputs": ["runtime/server/**", "!runtime/server/node_modules/**"]
    },
    "prepack": {
      "dependsOn": ["stage-server", "build"],
      "outputs": ["dist/**", "runtime/server/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
